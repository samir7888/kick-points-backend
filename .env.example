# Application Environment
APP_ENV=dev
MAX_REQUEST_BODY_BYTES=1048576
SECRET_KEY=dev-secret-key-32-chars-minimum-length
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/kick_predictions
# Optional: override the isolated database the test suite uses (derived as
# <DATABASE_URL>_test when unset). Tests delete users/channels/votes.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/kick_predictions_test
REDIS_URL=redis://localhost:6380/0

# API & Site URLs
API_URL=http://localhost:8000
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=localhost

# Admin Users (comma-separated Kick user IDs)
ADMIN_KICK_USER_IDS=

# Kick OAuth is documented; prediction voting still uses unverified legacy endpoints.
KICK_CLIENT_ID=dev_client_id
KICK_CLIENT_SECRET=dev_client_secret
KICK_AUTHORIZE_URL=https://id.kick.com/oauth/authorize
KICK_TOKEN_URL=https://id.kick.com/oauth/token
KICK_REVOKE_URL=https://id.kick.com/oauth/revoke
KICK_API_BASE=https://api.kick.com/public/v1
KICK_SCOPES=
KICK_REDIRECT_URI=
KICK_TIMEOUT_SECONDS=15

# Optional test account for the five-minute Kick canary
CANARY_CHANNEL_SLUG=
CANARY_ACCESS_TOKEN=

# Manual QR / bank-transfer payments (Nepal)
# Password for the `/payments` review page and its admin APIs.
PAYMENTS_ADMIN_PASSWORD=sameer12345
# Directory for uploaded payment-proof screenshots.
QR_PAYMENT_DIR=./uploads/qr-proofs
# Hard cap for the proof upload request body.
MAX_UPLOAD_BODY_BYTES=8388608
# Cloudinary proof storage. Set all three to upload proofs to Cloudinary;
# leave them blank to keep saving proofs under QR_PAYMENT_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kick-payment-proofs

# Product Rules
PREMIUM_PRICE_DISPLAY=1
FREE_CHANNEL_LIMIT=1
PREMIUM_CHANNEL_LIMIT=6
MIN_VOTE_AMOUNT=10
MIN_SECONDS_BEFORE_CLOSE=5
VOTE_JITTER_MAX_SECONDS=2